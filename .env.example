# コピーして値を入れる:
#   cp .env.example .env.local
# Next.js は .env → .env.local の順に読みます。.env.local が優先です。
# キーを変えたあとは `npm run dev` を再起動してください。
# NEXT_PUBLIC_ 付きの同名変数もフォールバックとして読みます（Vercel 向け）。

# 映画（無料登録: https://www.themoviedb.org/settings/api ）
# v3 API Key か、Read Access Token（JWT）のどちらかを設定してください。
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# 書籍（推奨。未設定でも Open Library で検索できます）
# Google Cloud で Books API を有効化し、API キーを発行:
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# 音楽（任意。未設定でも iTunes Search API で検索できます）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 認証と永続化（任意。未設定時はブラウザの localStorage に保存します）
# https://supabase.com/dashboard でプロジェクトを作り、Settings → API からコピー
# クライアント: src/lib/supabase.ts / 環境変数: src/lib/env.ts
# テーブル定義は supabase/schema.sql を SQL Editor で実行してください
# （profiles, shelf_items, reviews, follows, …）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
